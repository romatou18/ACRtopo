{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    /* --- ERROR PREVENTION --- */
    "no-undef": "error", // Catch typos in variable names (e.g., targetLat vs targetlat)
    "no-unused-vars": "warn", // Clean up debris (like old declination constants)
    "no-const-assign": "error", // Prevent reassignment of constants like NZTM math values
    "no-unreachable": "error", // Detect logic errors in your conversion functions
    "no-extra-semi": "warn", // Keep code clean
    "no-inner-declarations": "warn", // Prevent scoping issues in messy nested functions

    /* --- LANDSAR SPECIFIC SAFETY --- */
    "no-implicit-globals": "error", // Ensure variables don't leak into global scope accidentally
    "no-lonely-if": "warn", // Encourages cleaner logic in coordinate parsing
    "no-shadow": "warn", // Prevent using a variable name already used in outer scope
    "valid-typeof": "error", // Ensure type checks (e.g., typeof === 'number') are valid

    /* --- STYLE & READABILITY --- */
    "indent": ["warn", 4], // Enforce standard 4-space indentation
    "quotes": ["warn", "double"], // Ensure consistent string quoting
    "semi": ["error", "always"], // Require semicolons to prevent ASI (Automatic Semicolon Insertion) bugs
    "curly": "error", // Require {} for all if/else (essential for high-pressure code readability)
    "eqeqeq": ["error", "always"] // Use === instead of == to prevent "truthy" coordinate bugs
  }
}
